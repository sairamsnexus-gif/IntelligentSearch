# =====================================================================
# NEXUS configuration — copy to .env (never commit .env)
# Every service is optional. With nothing configured, NEXUS offers the
# clearly-labelled SYNTHETIC demo world. All values are read server-side
# only and are never sent to the browser or written into investigation files.
#
# ZERO-COST POLICY: only free, self-hosted or free-tier services. No paid API,
# no paid fallback, no automatic upgrade. See docs/NO_PAID_FALLBACK.md.
# =====================================================================

# ---- LLM gateway: FreeLLMAPI (github.com/joshcohen-ai/free-ai-tokens) — the ONLY LLM path
# Run it yourself (docker compose --profile llm up -d freellmapi), add FREE-tier provider
# keys in its dashboard (http://127.0.0.1:3001, local only), then copy its unified key here.
# Do not activate FreeLLMAPI "Premium" (paid licence) and do not add paid providers.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
# "auto" lets FreeLLMAPI route among your free providers; or name one free model.
FREELLMAPI_MODEL=auto
# Comma-separated models NEXUS may request (FREELLMAPI_MODEL must be in this list)
FREELLMAPI_MODEL_ALLOWLIST=auto
# Hard caps (in addition to per-investigation budgets and FreeLLMAPI's own limits)
NEXUS_LLM_DAILY_CALL_CAP=200
NEXUS_LLM_MAX_TOKENS=1500

# ---- Discovery engines (operator / local mode)
# SearXNG metasearch (AGPL-3.0, run unmodified): docker compose up -d searxng
SEARXNG_URL=http://localhost:8080
# GPT Researcher sidecar (services/gpt-researcher-sidecar): docker compose --profile engines up -d gpt-researcher
GPTR_SERVICE_URL=
# SpiderFoot (bind to localhost; set sfp_spider "robotsonly" = True in its settings)
SPIDERFOOT_URL=
# Maigret sidecar (services/osint-python)
MAIGRET_SERVICE_URL=

# Synthetic demo world: auto (offered when no discovery service is configured) | true | false
NEXUS_SYNTHETIC=auto

# ---- Hosted (Netlify) mode — no database, single operator account from env
# NEXUS_HOSTED=true is implied on Netlify (NETLIFY is set by the platform); set false to override.
NEXUS_HOSTED=
NEXUS_OPERATOR_EMAIL=
# Generate with: npm run hash-password   (stores only a scrypt hash, never the password)
NEXUS_OPERATOR_PASSWORD_HASH=

# ---- Auth — AUTH_SECRET signs session cookies. Generate: openssl rand -hex 32
# Required in production/hosted mode. In development an ephemeral secret is generated into ./.data/
AUTH_SECRET=

# =====================================================================
# Legacy person-search console (operator mode only; uses a local database)
# =====================================================================
# Excluded under the zero-cost policy and ignored by NEXUS: Brave, Serper, Tavily.
SEARCH_API_URL=
SCRAPER_API_URL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NEXUS/1.0
GITHUB_TOKEN=
YOUTUBE_API_KEY=
CHANGEDETECTION_URL=
CHANGEDETECTION_API_KEY=
# Leave empty to use the embedded Postgres (PGlite) in ./.data/pglite
DATABASE_URL=
MONITOR_INTERVAL_HOURS=24
MAX_DISCOVERY_ITERATIONS=3
MAX_QUERIES_PER_ITERATION=40
SEARCH_CONCURRENCY=4
DEMO_MODE=auto
RUN_WORKER_IN_PROCESS=true
APP_ENV=development
