# =====================================================================
# IntelligentSearch configuration
# Copy to .env and fill in only what you have. Every provider is optional.
# With no keys at all the app runs in DEMO MODE with clearly-labelled fake data.
# Keys are read server-side only and are never sent to the browser.
# =====================================================================

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional search providers
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Local SearXNG (docker compose up searxng)
SEARXNG_URL=http://localhost:8080

# Optional DeepSearch services (github.com/Tasmay-Tibrewal/deepsearch search.py / scraper.py)
SEARCH_API_URL=
SCRAPER_API_URL=

# Reddit (script app, client-credentials OAuth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=IntelligentSearch/1.0

# GitHub public API (optional token only raises the rate limit; no scopes needed)
GITHUB_TOKEN=

# YouTube Data API v3 (optional)
YOUTUBE_API_KEY=

# Python OSINT sidecar (Maigret username discovery) — services/osint-python
MAIGRET_SERVICE_URL=

# changedetection.io (optional external monitor)
CHANGEDETECTION_URL=
CHANGEDETECTION_API_KEY=

# Database — leave empty to use the embedded Postgres (PGlite) in ./.data/pglite
DATABASE_URL=

# Monitoring
MONITOR_INTERVAL_HOURS=24

# Discovery tuning
MAX_DISCOVERY_ITERATIONS=3
MAX_QUERIES_PER_ITERATION=40
SEARCH_CONCURRENCY=4

# Demo mode: auto (demo when no real web-search provider is reachable) | true | false
DEMO_MODE=auto

# Auth — AUTH_SECRET signs session cookies. Generate: openssl rand -hex 32
# If empty in development, a secret is generated into ./.data/auth-secret
AUTH_SECRET=

# Run the background job worker inside the Next.js server process (true for local dev).
# Set false in production and run `npm run worker` as a separate process.
RUN_WORKER_IN_PROCESS=true

# Application
APP_ENV=development
